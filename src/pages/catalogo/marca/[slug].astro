---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const products = await getCollection('productos', ({ data }) => data.published);
  const groups = new Map();
  for (const product of products) {
    const slug = product.data.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const group = groups.get(slug) ?? { name: product.data.brand, products: [] };
    group.products.push(product);
    groups.set(slug, group);
  }
  return [...groups].map(([slug, group]) => ({ params: { slug }, props: group }));
}

const { name, products: categoryProducts } = Astro.props;
---

<Layout title={`Turbos ${name} | Catálogo | Turbos México`} description={`Consulta los turbos ${name} publicados por Turbos México y solicita una cotización.`}>
  <section class="page-hero">
    <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a> / <a href="/catalogo/">Catálogo</a> / <span>{name}</span></nav>
    <span class="eyebrow">Categoría por marca</span>
    <h1>Turbos {name}</h1>
    <p>Modelos publicados de {name}. La compatibilidad, disponibilidad y precio se confirman antes de cotizar.</p>
  </section>
  <section class="section">
    <h2>Modelos de {name}</h2>
    <div class="grid product-grid">
      {categoryProducts.map((product) => (
        <article class="card product-card">
          <span class="eyebrow">{product.data.productType}</span>
          <h3>{product.data.name}</h3>
          <p>{product.data.description}</p>
          <a href={`/catalogo/${product.data.slug}/`}>Ver información del turbo →</a>
        </article>
      ))}
    </div>
  </section>
</Layout>
