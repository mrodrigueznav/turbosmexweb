---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const products = await getCollection('productos', ({ data }) => data.published);
  return products.map((product) => ({ params: { slug: product.data.slug }, props: { product } }));
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const canonicalPath = `/catalogo/${data.slug}/`;
const imageUrl = data.image ?? '/assets/turbo-catalogo.svg';
const quoteUrl = `/contacto/?producto=${encodeURIComponent(data.name)}&numero_parte=${encodeURIComponent(data.partNumbers[0])}&origen=${encodeURIComponent(canonicalPath)}`;
const whatsappUrl = `https://wa.me/524424760911?text=${encodeURIComponent(`Hola Turbos México, quiero cotizar ${data.name} (${data.partNumbers[0]}).`)}`;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  description: data.description,
  brand: { '@type': 'Brand', name: data.brand },
  mpn: data.partNumbers[0],
  image: new URL(imageUrl, 'https://turbosmexico.com.mx').toString(),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://turbosmexico.com.mx/' },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: 'https://turbosmexico.com.mx/catalogo/' },
    { '@type': 'ListItem', position: 3, name: data.name, item: `https://turbosmexico.com.mx${canonicalPath}` },
  ],
};
---

<Layout title={`${data.name} | Turbos México`} description={data.description} image={imageUrl}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <section class="page-hero product-hero">
    <div class="product-hero-content">
    <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a> / <a href="/catalogo/">Catálogo</a> / <span>{data.name}</span></nav>
    <span class="eyebrow">{data.brand} · {data.productType}</span>
    {data.example && <p class="example-label">Producto de ejemplo</p>}
    <h1>{data.name}</h1>
    <p>{data.description}</p>
    </div>
    <figure class="product-image">
      <img src={imageUrl} alt={`Imagen de ${data.name}`} />
      <figcaption>Imagen ilustrativa. Confirma la pieza con su placa y número de parte.</figcaption>
    </figure>
  </section>
  <section class="section product-detail">
    <div>
      <span class="eyebrow">Ficha técnica</span>
      <h2>Información del producto</h2>
      <div class="product-description"><Content /></div>
      <dl class="product-facts">
        <div><dt>Número de parte</dt><dd>{data.partNumbers.join(', ')}</dd></div>
        <div><dt>Aplicación confirmada</dt><dd>{data.applications.join(', ')}</dd></div>
        <div><dt>Condición comunicable</dt><dd>{data.condition}</dd></div>
        <div><dt>Disponibilidad</dt><dd>{data.availability}</dd></div>
      </dl>
    </div>
    <div class="product-quote">
      <span class="eyebrow">Siguiente paso</span>
      <h2>Confirma antes de comprar</h2>
      <p>{data.quoteInstructions}</p>
      <p>La publicación no implica precio, compatibilidad ni inventario confirmados.</p>
      <a class="button button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-product={data.name} data-part-number={data.partNumbers[0]}>Cotizar por WhatsApp</a>
      <a class="button button-primary" href={quoteUrl}>Solicitar cotización</a>
      <a class="button button-light" href="/servicios/venta/">Ver servicio de venta</a>
      <a class="button button-light" href="/servicios/refacciones/">Consultar refacciones</a>
      <a class="button button-dark" href="/servicios/reparacion/">¿Necesitas reparación?</a>
    </div>
  </section>
</Layout>
