import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="Quiénes somos | Turbos México" description="Conoce los servicios de Turbos México: venta, reparación y refacciones para turbocompresores, con sucursal en Querétaro y atención por paquetería en México.">
  <section class="page-hero"><span class="eyebrow">Turbos México</span><h1>Quiénes somos</h1><p>Ofrecemos soluciones para turbocompresores mediante venta, reparación y refacciones, con atención desde nuestra sucursal en Querétaro y servicio de paquetería a toda la República Mexicana.</p></section>
  <section class="section"><div class="section-heading"><span class="eyebrow">Nuestros servicios</span><h2>Atención para tu turbocompresor</h2><p>La información del vehículo, maquinaria o pieza nos permite revisar cada solicitud antes de confirmar compatibilidad, disponibilidad o el alcance del servicio.</p></div><div class="grid"><article class="card"><h3>Venta de turbos</h3><p>Orientación para solicitar un turbocompresor nuevo o una alternativa sujeta a confirmación.</p><a href="/servicios/venta/">Conocer venta de turbos →</a></article><article class="card"><h3>Reparación</h3><p>Revisión de los datos, síntomas y fotografías disponibles para orientar el siguiente paso.</p><a href="/servicios/reparacion/">Conocer reparación →</a></article><article class="card"><h3>Refacciones</h3><p>Identificación de componentes con la aplicación, número de parte y fotografías de la pieza.</p><a href="/servicios/refacciones/">Conocer refacciones →</a></article></div></section>
  <section class="section"><h2>Atención en Querétaro y envíos a México</h2><p>La sucursal física se encuentra en Querétaro. Si estás en otro estado, puedes solicitar atención y revisar el envío de tu turbo, reparación o refacción mediante paquetería.</p><div class="actions"><a class="button button-primary" href="/ubicaciones/">Ver ubicación y cobertura</a><a class="button button-dark" href="/contacto/">Contactar</a></div></section>
</Layout>
