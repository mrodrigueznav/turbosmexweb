---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="Contacto | Turbos México" description="Solicita una cotización, diagnóstico o refacción para tu turbocompresor. Contacta a Turbos México por WhatsApp, teléfono, correo o formulario.">
  <section class="page-hero"><span class="eyebrow">Estamos para ayudarte</span><h1>Solicita información</h1><p>Déjanos tus datos y un asesor de Turbos México se pondrá en contacto contigo.</p></section>
  <section class="section contact-grid">
    <div><h2>Hablemos de tu turbo</h2><div class="contact-list"><a href="https://wa.me/524424760911" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" aria-label="Enviar mensaje a Turbos México por WhatsApp (abre una pestaña nueva)">WhatsApp: +52 442 476 0911</a><a href="tel:+524424760911" data-track="phone_click">Teléfono: 442 476 0911</a><a href="mailto:ventas@turbosmexico.com.mx">ventas@turbosmexico.com.mx</a></div></div>
    <form class="contact-form" action="/api/contact.php" method="post" aria-describedby="form-status"><label for="nombre">Nombre<input id="nombre" name="nombre" required autocomplete="name" /></label><label for="correo">Correo electrónico<input id="correo" type="email" name="correo" required autocomplete="email" /></label><label for="telefono">Teléfono<input id="telefono" type="tel" name="telefono" required autocomplete="tel" /></label><label for="mensaje">¿Qué necesitas?<textarea id="mensaje" name="mensaje" required></textarea></label><input name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" /><button class="button button-dark" type="submit">Enviar solicitud</button><p id="form-status" class="form-status" aria-live="polite"></p><p class="contact-alternative">Si el formulario no está disponible, <a href="https://wa.me/524424760911" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click">escríbenos por WhatsApp</a>.</p></form>
  </section>
  <script is:inline>
    const form = document.querySelector('.contact-form');
    const status = form?.querySelector('.form-status');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Enviando…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.message || 'No pudimos enviar la solicitud. Escríbenos por WhatsApp.');
        form.reset();
        status.textContent = data.message || 'Solicitud enviada correctamente.';
        window.trackConversion?.('form_submit', { conversion_type: 'form_submission' });
      } catch (error) {
        status.textContent = error instanceof Error && error.message ? error.message : 'No pudimos enviar la solicitud. Escríbenos por WhatsApp.';
      }
    });
  </script>
</Layout>
