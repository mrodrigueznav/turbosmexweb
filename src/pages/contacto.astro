---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="Contacto | Turbos México"><section class="page-hero"><span class="eyebrow">Estamos para ayudarte</span><h1>Solicita información</h1><p>Déjanos tus datos y un asesor de Turbos México se pondrá en contacto contigo.</p></section><section class="section contact-grid"><div><h2>Hablemos de tu turbo</h2><div class="contact-list"><a href="https://wa.me/524424760911" target="_blank" rel="noopener" data-track="whatsapp_click">WhatsApp: +52 1 442 476 0911</a><a href="tel:+524424760911" data-track="phone_click">Teléfono: 442 476 0911</a><a href="mailto:ventas@turbosmexico.com.mx">ventas@turbosmexico.com.mx</a></div></div><form class="contact-form" action="/api/contact.php" method="post"><label>Nombre<input name="nombre" required autocomplete="name" /></label><label>Correo electrónico<input type="email" name="correo" required autocomplete="email" /></label><label>Teléfono<input type="tel" name="telefono" required autocomplete="tel" /></label><label>¿Qué necesitas?<textarea name="mensaje" required></textarea></label><input name="website" tabindex="-1" autocomplete="off" class="honeypot" /><button class="button button-dark" type="submit">Enviar solicitud</button><p class="form-status" aria-live="polite"></p></form></section><script>const form=document.querySelector('.contact-form');const status=form?.querySelector('.form-status');form?.addEventListener('submit',async(e)=>{e.preventDefault();status.textContent='Enviando…';try{const r=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});const data=await r.json();if(!r.ok)throw Error(data.message);form.reset();status.textContent=data.message||'Solicitud enviada correctamente.';if(typeof window.gtag==='function')window.gtag('event','form_submit');}catch(error){status.textContent=error.message||'No pudimos enviar la solicitud. Escríbenos por WhatsApp.';}});</script></Layout>
