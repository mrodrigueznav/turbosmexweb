---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="Contacto | Turbos México" description="Solicita una cotización, diagnóstico o refacción para tu turbocompresor. Contacta a Turbos México por WhatsApp, teléfono, correo o formulario.">
  <section class="page-hero"><span class="eyebrow">Estamos para ayudarte</span><h1>Solicita información</h1><p>Déjanos tus datos y un asesor de Turbos México se pondrá en contacto contigo.</p></section>
  <section class="section contact-grid">
    <div><h2>Hablemos de tu turbo</h2><div class="contact-list"><a href="https://wa.me/524424760911" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" aria-label="Enviar mensaje a Turbos México por WhatsApp (abre una pestaña nueva)">WhatsApp: +52 442 476 0911</a><a href="tel:+524424760911" data-track="phone_click">Teléfono: 442 476 0911</a><a href="mailto:ventas@turbosmexico.com.mx">ventas@turbosmexico.com.mx</a></div></div>
    <form class="contact-form" action="/api/contact.php" method="post" aria-describedby="form-status"><p id="product-context" class="form-context" hidden></p><input type="hidden" name="producto" /><input type="hidden" name="numero_parte" /><input type="hidden" name="landing_page" /><input type="hidden" name="request_url" /><input type="hidden" name="utm_source" /><input type="hidden" name="utm_medium" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="utm_term" /><input type="hidden" name="utm_content" /><input type="hidden" name="gclid" /><label for="nombre">Nombre<input id="nombre" name="nombre" required autocomplete="name" /></label><label for="correo">Correo electrónico<input id="correo" type="email" name="correo" required autocomplete="email" /></label><label for="telefono">Teléfono<input id="telefono" type="tel" name="telefono" required autocomplete="tel" /></label><label for="mensaje">¿Qué necesitas?<textarea id="mensaje" name="mensaje" required></textarea></label><input name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" /><button class="button button-dark" type="submit">Enviar solicitud</button><p id="form-status" class="form-status" aria-live="polite"></p><p class="contact-alternative">Si el formulario no está disponible, <a href="https://wa.me/524424760911" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click">escríbenos por WhatsApp</a>.</p></form>
  </section>
  <script is:inline>
    const form = document.querySelector('.contact-form');
    const status = form?.querySelector('.form-status');
    const params = new URLSearchParams(window.location.search);
    const campaignKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'];
    const storageGet = (key) => { try { return window.sessionStorage.getItem(key) || ''; } catch { return ''; } };
    const storageSet = (key, value) => { try { window.sessionStorage.setItem(key, value); } catch { /* storage can be unavailable */ } };
    const valueFor = (key) => params.get(key) || storageGet(`tm_${key}`);
    const landingPage = storageGet('tm_landing_page') || params.get('origen') || window.location.href;
    storageSet('tm_landing_page', landingPage);
    const field = (name) => form?.querySelector(`[name="${name}"]`);
    if (form) {
      field('producto').value = params.get('producto') || '';
      field('numero_parte').value = params.get('numero_parte') || '';
      field('landing_page').value = landingPage;
      field('request_url').value = window.location.href;
      campaignKeys.forEach((key) => { field(key).value = valueFor(key); });
    }
    const productContext = params.get('producto');
    if (productContext) {
      const partNumber = params.get('numero_parte');
      const context = document.querySelector('#product-context');
      context.textContent = `Solicitud sobre ${productContext}${partNumber ? ` (${partNumber})` : ''}.`;
      context.hidden = false;
    }
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Enviando…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.message || 'No pudimos enviar la solicitud. Escríbenos por WhatsApp.');
        form.reset();
        status.textContent = data.message || 'Solicitud enviada correctamente.';
        window.trackConversion?.('form_submit', { conversion_type: 'form_submission' });
      } catch (error) {
        status.textContent = error instanceof Error && error.message ? error.message : 'No pudimos enviar la solicitud. Escríbenos por WhatsApp.';
      }
    });
  </script>
</Layout>
