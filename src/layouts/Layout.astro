---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Turbos México | Venta y reparación de turbocompresores',
  description = 'Venta, reparación y refacciones para turbocompresores automotrices, diésel, agrícolas y de equipo pesado en México.',
} = Astro.props;
const phone = '+524424760911';
const whatsapp = `https://wa.me/524424760911?text=${encodeURIComponent('Hola Turbos México, necesito información sobre un turbo.')}`;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo-turbos-mexico.png" />
    <title>{title}</title>
    <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
      if (gaId) {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.appendChild(script);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', gaId);
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Turbos México, inicio">
        <img src="/assets/logo-turbos-mexico.png" alt="Turbos México" />
      </a>
      <button class="menu-button" type="button" aria-label="Abrir menú" aria-controls="site-navigation" aria-expanded="false">
        <span aria-hidden="true">☰</span>
      </button>
      <nav id="site-navigation" aria-label="Navegación principal">
        <a href="/servicios/venta/">Venta</a>
        <a href="/servicios/reparacion/">Reparación</a>
        <a href="/servicios/refacciones/">Refacciones</a>
        <a href="/#aplicaciones">Aplicaciones</a>
        <a href="/ubicaciones/">Ubicaciones</a>
        <a href="/contacto/">Contacto</a>
      </nav>
      <a class="header-phone" href={`tel:${phone}`} data-track="phone_click" aria-label="Llamar a Turbos México al 442 476 0911">442 476 0911</a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div>
        <img src="/assets/logo-turbos-mexico.png" alt="Turbos México" />
        <p>Soluciones confiables para turbocompresores en México.</p>
      </div>
      <div>
        <strong>Contacto</strong>
        <a href={`mailto:ventas@turbosmexico.com.mx`}>ventas@turbosmexico.com.mx</a>
        <a href={`tel:${phone}`} data-track="phone_click">442 476 0911</a>
      </div>
      <div>
        <strong>Explora</strong>
        <a href="/servicios/venta/">Venta de turbos</a>
        <a href="/servicios/reparacion/">Reparación</a>
        <a href="/servicios/refacciones/">Refacciones</a>
      </div>
      <div>
        <strong>Redes sociales</strong>
        <div class="social-links" aria-label="Redes sociales oficiales">
          <a href="https://www.facebook.com/turbosmexico/" target="_blank" rel="noopener noreferrer" data-track="social_facebook" aria-label="Turbos México en Facebook"><svg class="social-icon social-icon-facebook" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 8h3V4h-3c-3.3 0-5 1.7-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.7.3-1 1-1Z" /></svg></a>
          <a href="https://www.instagram.com/turbos.mexico/" target="_blank" rel="noopener noreferrer" data-track="social_instagram" aria-label="Turbos México en Instagram"><svg class="social-icon social-icon-instagram" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg></a>
          <a href="https://www.youtube.com/channel/UCtFUgAvBEVE8-OyeI-24qng/videos" target="_blank" rel="noopener noreferrer" data-track="social_youtube" aria-label="Turbos México en YouTube"><svg class="social-icon social-icon-youtube" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.6 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .4-3.8 29 29 0 0 0-.4-3.8ZM10 15V9l5 3-5 3Z" /></svg></a>
        </div>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Turbos México. Todos los derechos reservados.</p>
    </footer>
    <a class="whatsapp-float" href={whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" aria-label="Enviar mensaje a Turbos México por WhatsApp">WA</a>
    <script is:inline>
      const menuButton = document.querySelector('.menu-button');
      const navigation = document.querySelector('#site-navigation');
      const setMenu = (open) => {
        navigation?.classList.toggle('open', open);
        menuButton?.setAttribute('aria-expanded', String(open));
        menuButton?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        if (!open) menuButton?.focus();
      };
      setMenu(false);
      menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
      document.querySelectorAll('[data-track]').forEach((element) => element.addEventListener('click', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', element.dataset.track, {
            link_url: element.href,
            ...(element.dataset.branch && { branch_location: element.dataset.branch }),
            page_location: window.location.href,
            page_title: document.title,
          });
        }
      }));
    </script>
  </body>
</html>
