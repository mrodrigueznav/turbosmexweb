---
const { title = 'Turbos México | Venta y reparación de turbocompresores', description = 'Venta, reparación y refacciones para turbocompresores en México.' } = Astro.props;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo-turbos-mexico.png" />
    <title>{title}</title>
    <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
      if (gaId) { const s=document.createElement('script'); s.async=true; s.src=`https://www.googletagmanager.com/gtag/js?id=${gaId}`; document.head.appendChild(s); window.dataLayer=window.dataLayer||[]; window.gtag=function(){window.dataLayer.push(arguments)}; window.gtag('js',new Date()); window.gtag('config',gaId); }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Turbos México, inicio"><img src="/assets/logo-turbos-mexico.png" alt="Turbos México" /></a>
      <nav aria-label="Navegación principal"><a href="/#servicios">Servicios</a><a href="/#aplicaciones">Aplicaciones</a><a href="/ubicaciones/">Ubicaciones</a><a href="/contacto/">Contacto</a></nav>
      <a class="header-phone" href="tel:+524424760911" data-track="phone_click">442 476 0911</a>
      <button class="menu-button" aria-label="Abrir menú" aria-expanded="false">☰</button>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div><img src="/assets/logo-turbos-mexico.png" alt="Turbos México" /><p>Soluciones confiables para turbocompresores en México.</p></div><div><strong>Contacto</strong><a href="mailto:ventas@turbosmexico.com.mx">ventas@turbosmexico.com.mx</a><a href="tel:+524424760911">442 476 0911</a></div><div><strong>Redes sociales</strong><a href="https://www.facebook.com/turbosmexico/" rel="noopener">Facebook</a><a href="https://www.instagram.com/turbos.mexico/" rel="noopener">Instagram</a></div><p class="copyright">© {new Date().getFullYear()} Turbos México. Todos los derechos reservados.</p></footer>
    <a class="whatsapp-float" href="https://wa.me/524424760911?text=Hola%20Turbos%20M%C3%A9xico%2C%20necesito%20informaci%C3%B3n%20sobre%20un%20turbo." target="_blank" rel="noopener" data-track="whatsapp_click" aria-label="Contactar por WhatsApp">WA</a>
    <script>document.querySelector('.menu-button')?.addEventListener('click',(e)=>{const b=e.currentTarget;document.querySelector('nav')?.classList.toggle('open');b.setAttribute('aria-expanded',String(b.getAttribute('aria-expanded')!=='true'))});document.querySelectorAll('[data-track]').forEach((el)=>el.addEventListener('click',()=>{if(typeof window.gtag==='function')window.gtag('event',el.dataset.track,{link_url:el.href})}));</script>
  </body>
</html>
