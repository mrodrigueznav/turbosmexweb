# Legacy URL migration rules. Install this file on the Apache vhost serving
# the old domain before changing DNS. Destinations are final canonical routes.
Redirect 301 /contactanos/ /contacto/
Redirect 301 /sucursal-queretaro/ /ubicaciones/#sucursal-queretaro
Redirect 301 /sucursal-tlalnepantla/ /ubicaciones/#sucursal-tlalnepantla
Redirect 301 /tipos-de-turbos/ /servicios/venta/
Redirect 301 /turbos-garrett/ /servicios/venta/
